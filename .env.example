# POLARIS Vercel & Production Environment Variables

# MongoDB Atlas Connection URI (Required for persistent cloud database)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/polaris?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://your-cluster.mongodb.net/polaris

# JWT Secrets for authentication (Generate random 32+ char hex strings)
JWT_ACCESS_SECRET=polaris-production-jwt-access-secret-32-chars-key
JWT_REFRESH_SECRET=polaris-production-jwt-refresh-secret-32-chars-key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Environment
NODE_ENV=production

# Optional: If hosting backend API on a different domain than frontend
# VITE_API_URL=https://your-backend-api.vercel.app/api/v1
