{
  "name": "polaris-polar-logistics",
  "version": "1.0.0",
  "description": "POLARIS — Polar Logistics and Resource Intelligence System (SIH26062)",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate --schema=backend/prisma/schema.prisma",
    "build": "prisma generate --schema=backend/prisma/schema.prisma && cd frontend && npm install --include=dev && npm run build",
    "vercel-build": "prisma generate --schema=backend/prisma/schema.prisma && cd frontend && npm install --include=dev && npm run build",
    "seed": "cd backend && npm run seed",
    "start": "cd backend && npm start"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.1",
    "@types/uuid": "^10.0.0",
    "@vercel/node": "^5.1.13",
    "prisma": "^5.22.0",
    "typescript": "5.8.3"
  }
}
