// POLARIS — Prisma Schema for TiDB Cloud (MySQL-compatible)
// Matches docs/schema.sql exactly

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Stations ───────────────────────────────────────────────────────────────
model Station {
  id        String        @id @default(uuid())
  name      String
  code      String        @unique
  location  String
  lat       Decimal       @db.Decimal(10, 6)
  lon       Decimal       @db.Decimal(10, 6)
  status    StationStatus @default(active)
  timezone  String        @default("UTC")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  users                 User[]
  expeditions           Expedition[]
  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  shipments             Shipment[]
  personnel             Personnel[]
  assets                Asset[]
  incidents             Incident[]

  @@map("stations")
}

// ── Users ──────────────────────────────────────────────────────────────────
model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  password            String
  role                UserRole
  stationId           String?   @map("station_id")
  isActive            Boolean   @default(true) @map("is_active")
  refreshTokenVersion Int       @default(0) @map("refresh_token_version")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  station               Station?              @relation(fields: [stationId], references: [id], onDelete: SetNull)
  expeditionsCreated    Expedition[]
  inventoryTransactions InventoryTransaction[]
  maintenanceRecords    MaintenanceRecord[]
  incidentsReported     Incident[]            @relation("IncidentReportedBy")
  incidentsAcknowledged Incident[]            @relation("IncidentAcknowledgedBy")
  incidentsResolved     Incident[]            @relation("IncidentResolvedBy")
  auditLogs             AuditLog[]

  @@map("users")
}

// ── Expeditions ────────────────────────────────────────────────────────────
model Expedition {
  id               String                @id @default(uuid())
  name             String
  missionType      ExpeditionMissionType @map("mission_type")
  destinationId    String                @map("destination_id")
  startDate        DateTime              @map("start_date")
  endDate          DateTime              @map("end_date")
  status           ExpeditionStatus      @default(draft)
  planningProgress Int                   @default(0) @map("planning_progress")
  description      String?               @db.Text
  createdBy        String?               @map("created_by")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  destination Station    @relation(fields: [destinationId], references: [id])
  creator     User?      @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  shipments   Shipment[]
  incidents   Incident[]

  @@map("expeditions")
}

// ── Inventory Items ────────────────────────────────────────────────────────
model InventoryItem {
  id               String            @id @default(uuid())
  name             String
  sku              String            @unique
  category         InventoryCategory
  unit             String
  onHandQuantity   Decimal           @default(0) @map("on_hand_quantity") @db.Decimal(12, 2)
  reservedQuantity Decimal           @default(0) @map("reserved_quantity") @db.Decimal(12, 2)
  minThreshold     Decimal           @default(0) @map("min_threshold") @db.Decimal(12, 2)
  targetStock      Decimal           @default(0) @map("target_stock") @db.Decimal(12, 2)
  unitCost         Decimal?          @default(0) @map("unit_cost") @db.Decimal(10, 2)
  storageLocation  String?           @map("storage_location")
  supplier         String?
  stationId        String            @map("station_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  station      Station                @relation(fields: [stationId], references: [id])
  transactions InventoryTransaction[]

  @@map("inventory_items")
}

// ── Inventory Transactions ─────────────────────────────────────────────────
model InventoryTransaction {
  id               String          @id @default(uuid())
  itemId           String          @map("item_id")
  stationId        String          @map("station_id")
  type             TransactionType
  quantity         Decimal         @db.Decimal(12, 2)
  balanceAfter     Decimal         @map("balance_after") @db.Decimal(12, 2)
  referenceType    String?         @map("reference_type")
  referenceId      String?         @map("reference_id")
  notes            String?         @db.Text
  performedBy      String?         @map("performed_by")
  clientMutationId String?         @unique @map("client_mutation_id")
  createdAt        DateTime        @default(now()) @map("created_at")

  item      InventoryItem @relation(fields: [itemId], references: [id])
  station   Station       @relation(fields: [stationId], references: [id])
  performer User?         @relation(fields: [performedBy], references: [id], onDelete: SetNull)

  @@map("inventory_transactions")
}

// ── Shipments ──────────────────────────────────────────────────────────────
model Shipment {
  id               String         @id @default(uuid())
  shipmentNumber   String         @unique @map("shipment_number")
  origin           String
  destinationId    String         @map("destination_id")
  expeditionId     String?        @map("expedition_id")
  status           ShipmentStatus @default(manifest_created)
  departureDate    DateTime?      @map("departure_date")
  estimatedArrival DateTime?      @map("estimated_arrival")
  actualArrival    DateTime?      @map("actual_arrival")
  trackingNumber   String?        @map("tracking_number")
  vesselName       String?        @map("vessel_name")
  notes            String?        @db.Text
  clientMutationId String?        @unique @map("client_mutation_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  destination Station    @relation(fields: [destinationId], references: [id])
  expedition  Expedition? @relation(fields: [expeditionId], references: [id], onDelete: SetNull)
  cargoItems  CargoItem[]

  @@map("shipments")
}

// ── Cargo Items ────────────────────────────────────────────────────────────
model CargoItem {
  id             String   @id @default(uuid())
  shipmentId     String   @map("shipment_id")
  description    String
  quantity       Decimal  @db.Decimal(10, 2)
  unit           String
  weightKg       Decimal? @map("weight_kg") @db.Decimal(10, 2)
  volumeM3       Decimal? @map("volume_m3") @db.Decimal(10, 2)
  hazardous      Boolean  @default(false)
  received       Boolean  @default(false)
  conditionNotes String?  @map("condition_notes") @db.Text

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("cargo_items")
}

// ── Personnel ──────────────────────────────────────────────────────────────
model Personnel {
  id                   String          @id @default(uuid())
  name                 String
  role                 String
  medicalClearanceDate DateTime?       @map("medical_clearance_date") @db.Date
  clearanceStatus      ClearanceStatus @default(valid) @map("clearance_status")
  bloodGroup           String?         @map("blood_group")
  emergencyContact     String?         @map("emergency_contact")
  stationId            String          @map("station_id")
  currentStatus        PersonnelStatus @default(at_station) @map("current_status")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  station Station @relation(fields: [stationId], references: [id])

  @@map("personnel")
}

// ── Assets ─────────────────────────────────────────────────────────────────
model Asset {
  id              String         @id @default(uuid())
  assetTag        String         @unique @map("asset_tag")
  name            String
  category        AssetCategory
  status          AssetStatus    @default(operational)
  stationId       String         @map("station_id")
  hourMeter       Int            @default(0) @map("hour_meter")
  nextServiceDue  Int            @default(250) @map("next_service_due")
  lastServiceDate DateTime?      @map("last_service_date")
  criticalRating  CriticalRating @default(medium) @map("critical_rating")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  station            Station             @relation(fields: [stationId], references: [id])
  maintenanceRecords MaintenanceRecord[]

  @@map("assets")
}

// ── Maintenance Records ────────────────────────────────────────────────────
model MaintenanceRecord {
  id             String      @id @default(uuid())
  assetId        String      @map("asset_id")
  performedAt    DateTime    @default(now()) @map("performed_at")
  serviceType    ServiceType @map("service_type")
  hoursAtService Int         @map("hours_at_service")
  performedBy    String?     @map("performed_by")
  notes          String?     @db.Text
  cost           Decimal     @default(0) @db.Decimal(10, 2)
  nextServiceDue Int?        @map("next_service_due")

  asset     Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  performer User? @relation(fields: [performedBy], references: [id], onDelete: SetNull)

  @@map("maintenance_records")
}

// ── Incidents ──────────────────────────────────────────────────────────────
model Incident {
  id                  String           @id @default(uuid())
  incidentNumber      String           @unique @map("incident_number")
  title               String
  severity            IncidentSeverity
  category            IncidentCategory
  status              IncidentStatus   @default(open)
  stationId           String           @map("station_id")
  expeditionId        String?          @map("expedition_id")
  locationDescription String?          @map("location_description") @db.Text
  reportedBy          String?          @map("reported_by")
  reportedAt          DateTime         @default(now()) @map("reported_at")
  acknowledgedAt      DateTime?        @map("acknowledged_at")
  acknowledgedBy      String?          @map("acknowledged_by")
  resolvedAt          DateTime?        @map("resolved_at")
  resolvedBy          String?          @map("resolved_by")
  resolutionNotes     String?          @map("resolution_notes") @db.Text
  clientMutationId    String?          @unique @map("client_mutation_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  station    Station    @relation(fields: [stationId], references: [id])
  expedition Expedition? @relation(fields: [expeditionId], references: [id], onDelete: SetNull)
  reporter   User?      @relation("IncidentReportedBy", fields: [reportedBy], references: [id], onDelete: SetNull)
  acknowledger User?    @relation("IncidentAcknowledgedBy", fields: [acknowledgedBy], references: [id], onDelete: SetNull)
  resolver   User?      @relation("IncidentResolvedBy", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@map("incidents")
}

// ── Alerts ─────────────────────────────────────────────────────────────────
model Alert {
  id            String        @id @default(uuid())
  type          AlertType
  severity      AlertSeverity
  entityType    String        @map("entity_type")
  entityId      String        @map("entity_id")
  reason        String        @db.Text
  status        AlertStatus   @default(open)
  lastCheckedAt DateTime      @default(now()) @map("last_checked_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@unique([type, entityId, status], name: "unique_open_alert")
  @@map("alerts")
}

// ── Audit Logs ─────────────────────────────────────────────────────────────
model AuditLog {
  id               String   @id @default(uuid())
  action           String
  entityType       String   @map("entity_type")
  entityId         String   @map("entity_id")
  performedBy      String?  @map("performed_by")
  beforeJson       Json?    @map("before_json")
  afterJson        Json?    @map("after_json")
  clientMutationId String?  @map("client_mutation_id")
  createdAt        DateTime @default(now()) @map("created_at")

  performer User? @relation(fields: [performedBy], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ════════════════════════════════════════════════════════════════════════════
// Enums (must match TiDB ENUM definitions in schema.sql exactly)
// ════════════════════════════════════════════════════════════════════════════

enum StationStatus {
  active
  winter_over    @map("winter-over")
  decommissioned
}

enum UserRole {
  admin
  expedition_coordinator
  logistics_officer
  inventory_manager
  personnel_coordinator
  emergency_coordinator
  station_ops
}

enum ExpeditionMissionType {
  scientific
  resupply
  maintenance
  emergency
  survey
}

enum ExpeditionStatus {
  draft
  planned
  active
  completed
  cancelled
}

enum InventoryCategory {
  fuel
  rations
  medical
  spare_parts
  scientific_equipment
  safety_gear
}

enum TransactionType {
  inbound
  outbound
  consumption
  adjustment
  loss
}

enum ShipmentStatus {
  manifest_created
  in_transit
  arrived
  received
  delayed
  cancelled
}

enum ClearanceStatus {
  valid
  expiring_soon
  expired
  failed
}

enum PersonnelStatus {
  at_station
  on_assignment
  in_transit
  evacuated
}

enum AssetCategory {
  heavy_machinery
  generator
  life_support
  vehicle
  scientific_instrument
  communication
}

enum AssetStatus {
  operational
  maintenance_due
  under_repair
  decommissioned
}

enum CriticalRating {
  low
  medium
  high
  critical
}

enum ServiceType {
  routine
  repair
  emergency
  inspection
}

enum IncidentSeverity {
  minor
  moderate
  severe
  critical
}

enum IncidentCategory {
  medical
  weather_damage
  equipment_failure
  crevasse_fall
  whiteout_disorientation
  power_loss
  fuel_spill
}

enum IncidentStatus {
  open
  investigating
  mitigated
  resolved
  closed
}

enum AlertType {
  low_stock
  shipment_delayed
  forecast_threshold
  maintenance_due
  critical_incident_unacknowledged
  cargo_arrived_not_received
  inventory_inconsistency
}

enum AlertSeverity {
  info
  warning
  critical
}

enum AlertStatus {
  open
  acknowledged
  resolved
}
